// Firestore 安全規則（Firebase 專案：tsla-academy，學院專用）
// 用法：Firebase Console → tsla-academy → Firestore Database → 規則（Rules）→ 成段貼上 → 發佈（Publish）
// 加／減家庭成員：改下面 email 清單，同時改 js/cloud-config.js 入面嘅 members

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function academyFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bill27122002@gmail.com', 'ivantsang24@gmail.com'];
    }
    // 成員資料（名稱、頭像、顏色）：全家睇到，只可以改自己
    match /academyMembers/{uid} {
      allow read: if academyFamily();
      allow write: if academyFamily() && request.auth.uid == uid;
    }
    // 每人嘅學習資料（進度、書籤、筆記、螢光筆、交易日誌）：全家睇到，只可以改自己
    match /academyUsers/{uid}/parts/{part} {
      allow read: if academyFamily();
      allow write: if academyFamily() && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }
    // 留言同影片：全家睇到；只可以新增自己名下、改／刪自己嘅
    match /academyComments/{id} {
      allow read: if academyFamily();
      allow create: if academyFamily() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if academyFamily() && resource.data.uid == request.auth.uid;
    }
    match /academyVideos/{id} {
      allow read: if academyFamily();
      allow create: if academyFamily() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if academyFamily() && resource.data.uid == request.auth.uid;
    }
  }
}
